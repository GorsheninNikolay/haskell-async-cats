cabal-version:      2.4
name:               haskell-async-cats
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             you
maintainer:         you@example.com
build-type:         Simple
extra-source-files: README.md

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import: warnings
  hs-source-dirs: app
  exposed-modules:
    Cat.Api
    Cat.Factory
    Cat.Types
    Cat.Zip
  build-depends:
    base >=4.16 && <5,
    async >=2.2 && <2.3,
    bytestring >=0.10 && <0.13,
    zip-archive >=0.4 && <0.5,
    containers >=0.6 && <0.8,
    cryptonite >=0.30 && <0.31,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.4,
    http-types >=0.12 && <0.13,
    memory >=0.14 && <0.19
  default-language: Haskell2010

executable haskell-async-cats
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  other-modules:
    Cat.Api
    Cat.Factory
    Cat.Types
    Cat.Zip
  build-depends:
    base >=4.16 && <5,
    bytestring >=0.10 && <0.13,
    async >=2.2 && <2.3,
    zip-archive >=0.4 && <0.5,
    containers >=0.6 && <0.8,
    cryptonite >=0.30 && <0.31,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.4,
    http-types >=0.12 && <0.13,
    memory >=0.14 && <0.19,
    haskell-async-cats
  default-language: Haskell2010

